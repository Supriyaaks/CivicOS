# ==============================================================================
# CivicOS — Person 4: Node/Express & Prisma Backend Configuration
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection
# Example local: postgresql://postgres:password@localhost:5432/civicos?schema=public
# Example production (Neon/Supabase/AWS RDS): postgresql://db_user:db_pass@ep-cool-db.us-east-1.aws.neon.tech/civicos?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/civicos?schema=public"

# Cross-Origin Resource Sharing (CORS) - Allowed Frontend Origins
# Comma-separated list of allowed origins
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,https://civicos.vercel.app"

# Microservice Integrations
# Person 2 AI Engine (FastAPI + YOLO)
PERSON2_AI_URL="http://127.0.0.1:8000"

# Person 3 Predictive Engine (FastAPI + Graph + ML)
PERSON3_PREDICTIVE_URL="http://127.0.0.1:8001"

# Optional Ollama LLM Assistant (Leave blank or fallback if not deployed)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# Storage & Evidence Provider: "local" | "supabase" | "s3"
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Supabase Cloud Storage (Required only if STORAGE_PROVIDER=supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRES_IN="7d"
