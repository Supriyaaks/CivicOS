# ==============================================================================
# CivicOS — Master Environment Variable Template
# ==============================================================================
# Copy the respective service templates to their project roots:
# 1. Frontend:        civicos_person1/civicos/.env
# 2. Express Backend: backend/backend/.env
# 3. Person 2 AI:     CivicOS/.env
# 4. Person 3 Risk:   CivicOS_Person3/CivicOS_Person3/.env

# --- PERSON 4: EXPRESS BACKEND (Port 5000) ---
PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/civicos?schema=public"
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
PERSON2_AI_URL="http://127.0.0.1:8000"
PERSON3_PREDICTIVE_URL="http://127.0.0.1:8001"
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
JWT_SECRET="civicos-dev-jwt-secret-replace-in-production"

# --- PERSON 1: REACT FRONTEND (Port 5173) ---
VITE_BACKEND_API_URL=
VITE_AI_API_URL=
VITE_PREDICTIVE_API_URL=

# --- PERSON 2: AI ENGINE (Port 8000) ---
FASTAPI_PORT=8000
ACTIVE_MODEL_KEY="v1_3class"
CIVICOS_REQUIRE_AUTH=false

# --- PERSON 3: PREDICTIVE ENGINE (Port 8001) ---
FASTAPI_PORT=8001
CORS_ORIGINS="*"
