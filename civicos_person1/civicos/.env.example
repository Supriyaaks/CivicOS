# ==============================================================================
# CivicOS — Person 1: React + Vite Frontend Configuration
# ==============================================================================
# NOTE: Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put database passwords, service-role keys, or private API secrets here.

# Person 4 Express Backend API URL
# Leave empty in local development to use Vite reverse proxy (/api/v1)
# In production, set to your deployed backend origin (e.g. https://civicos-api.onrender.com)
VITE_BACKEND_API_URL=

# Person 2 AI Engine URL (Optional direct client access if proxy is not used)
VITE_AI_API_URL=

# Person 3 Predictive Engine URL (Optional direct client access if proxy is not used)
VITE_PREDICTIVE_API_URL=

# Supabase Public Integration (Only if direct client authentication/storage is used)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Application Metadata
VITE_APP_TITLE="CivicOS Smart City Civic Incident Platform"
VITE_APP_ENV=production
