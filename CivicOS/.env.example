# ==============================================================================
# CivicOS — Person 2: AI Vision Engine (FastAPI + YOLO) Configuration
# ==============================================================================

# Server Network Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
PORT=8000

# Active Model Selection (Preserved: v1_3class)
ACTIVE_MODEL_KEY="v1_3class"
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640

# Verification & Spatial Comparison Thresholds
GEO_DISTANCE_THRESHOLD_METERS=50
TIME_DIFF_THRESHOLD_HOURS=48
IMAGE_SIMILARITY_THRESHOLD=0.85
RESOLUTION_CONFIDENCE_THRESHOLD=0.7

# Supabase Authentication (Set to true in production if enforcing bearer token checks)
CIVICOS_REQUIRE_AUTH=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
